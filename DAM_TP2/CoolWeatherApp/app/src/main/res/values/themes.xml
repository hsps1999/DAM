<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.CoolWeatherApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>

        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>

        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>

        <item name="android:textColor">@color/WeatherLabel</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Theme.Day" parent="Theme.CoolWeatherApp">
        <item name="android:windowBackground">@drawable/fundo_dia</item>
    </style>

    <style name="Theme.Day_Land" parent="Theme.CoolWeatherApp">
        <item name="android:windowBackground">@drawable/fundo_dia_land</item>
    </style>

    <style name="Theme.Night" parent="Theme.CoolWeatherApp">
        <item name="android:windowBackground">@drawable/fundo_noite</item>
    </style>

    <style name="Theme.Night_Land" parent="Theme.CoolWeatherApp">
        <item name="android:windowBackground">@drawable/fundo_noite_land</item>
    </style>
</resources>